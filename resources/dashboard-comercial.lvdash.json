{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas conformadas",
      "queryLines": [
        "SELECT item_id, pedido_id, data_pedido, ano, mes, canal, cliente_id,\n",
        "       razao_social, segmento, cidade, uf, vendedor_id, sku, categoria,\n",
        "       marca, nota_olfativa, quantidade, preco_praticado, receita, custo, margem, devolucao\n",
        "FROM fato_vendas\n"
      ],
      "columns": [
        {
          "displayName": "Receita",
          "description": "Receita líquida conformada, incluindo devoluções e sem pedidos cancelados.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem",
          "description": "Receita menos custo do produto, sem desconto comercial ou frete.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Pedidos",
          "description": "Quantidade de pedidos válidos distintos.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio",
          "description": "Receita dividida pela quantidade de pedidos válidos distintos.",
          "expression": "SUM(`receita`) / NULLIF(COUNT(DISTINCT `pedido_id`), 0)"
        },
        {
          "displayName": "Margem %",
          "description": "Percentual de margem calculado como 100 vezes margem dividida pela receita.",
          "expression": "100.0 * SUM(`margem`) / NULLIF(SUM(`receita`), 0)"
        }
      ]
    }
  ],
