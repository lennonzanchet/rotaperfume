{
  "datasets": [
    {
      "name": "ds_vendas",
      "displayName": "Vendas conformadas",
      "queryLines": [
        "SELECT item_id, pedido_id, data_pedido, ano, mes, canal, cliente_id,\n",
        "       razao_social, segmento, cidade, uf, vendedor_id, sku, categoria,\n",
        "       marca, nota_olfativa, quantidade, preco_praticado, receita, custo, margem, devolucao\n",
        "FROM fato_vendas\n"
      ],
      "columns": [
        {
          "displayName": "Receita Total",
          "description": "Receita líquida conformada, incluindo devoluções e sem pedidos cancelados.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Margem Total",
          "description": "Receita menos custo do produto, sem desconto comercial ou frete.",
          "expression": "SUM(`margem`)"
        },
        {
          "displayName": "Quantidade de Pedidos",
          "description": "Quantidade de pedidos válidos distintos.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio Comercial",
          "description": "Receita dividida pela quantidade de pedidos válidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Margem Percentual",
          "description": "Proporção da receita que permanece como margem, expressa em escala de zero a um.",
          "expression": "SUM(`margem`) / NULLIF(SUM(`receita`), 0)"
        }
      ]
    },
    {
      "name": "ds_top_clientes",
      "displayName": "Top 20 clientes por receita",
      "queryLines": [
        "WITH top_clientes AS (\n",
        "  SELECT cliente_id\n",
        "  FROM fato_vendas\n",
        "  GROUP BY cliente_id\n",
        "  ORDER BY SUM(receita) DESC\n",
        "  LIMIT 20\n",
        ")\n",
        "SELECT vendas.ano, vendas.cliente_id, vendas.razao_social, vendas.segmento,\n",
        "       vendas.cidade, vendas.uf, vendas.pedido_id, vendas.receita\n",
        "FROM fato_vendas AS vendas\n",
        "INNER JOIN top_clientes ON vendas.cliente_id = top_clientes.cliente_id\n"
      ],
      "columns": [
        {
          "displayName": "Receita Top Clientes",
          "description": "Receita líquida conformada do cliente entre os vinte maiores do período completo.",
          "expression": "SUM(`receita`)"
        },
        {
          "displayName": "Pedidos Top Clientes",
          "description": "Quantidade de pedidos distintos do cliente entre os vinte maiores.",
          "expression": "COUNT(DISTINCT `pedido_id`)"
        },
        {
          "displayName": "Ticket Médio Top Clientes",
          "description": "Receita do cliente dividida pela quantidade de pedidos distintos.",
          "expression": "SUM(`receita`) / COUNT(DISTINCT `pedido_id`)"
        }
      ]
    }
  ],
